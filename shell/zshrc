# Interactive shells only.

# Load common environment if .zprofile did not run (non-login interactive).
[[ -z "$MY_ENV_LOADED" ]] && source ~/.config/shell/env.sh
export MY_ENV_LOADED=1

[[ -o interactive ]] || return

# Completion. Deduplicate fpath first: Herdr panes inherit an already-populated
# fpath, and duplicates make compinit noticeably slower.
fpath=(${(u)fpath})
autoload -Uz compinit && compinit

# sheldon (plugin manager)
eval "$(sheldon source)"

# mise (version manager)
eval "$(mise activate zsh)"

# uv (python)
eval "$(uv generate-shell-completion zsh)"

# fzf (fuzzy finder)
source <(fzf --zsh)
export FZF_DEFAULT_COMMAND='fd --type f --hidden --follow --exclude .git'
export FZF_DEFAULT_OPTS='--height=40% --layout=reverse --border --info=inline'
export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
export FZF_ALT_C_COMMAND='fd --type d --hidden --follow --exclude .git'

# zoxide (smart cd)
eval "$(zoxide init zsh)"

# direnv (per-directory env). Not installed on every machine.
if (( $+commands[direnv] )); then
  eval "$(direnv hook zsh)"
fi

# starship (prompt)
eval "$(starship init zsh)"

# Aliases and shell functions
source ~/.config/shell/aliases.zsh
source ~/.config/shell/herdr.zsh
alias ls='eza'
alias ll='eza -l'
alias la='eza -la'
alias tree='eza --tree'
alias cat='bat'
alias grep='rg'
alias find='fd'
alias diff='delta'

# Machine-specific settings, not tracked in the dotfiles repo.
[[ -f ~/.zshrc.local ]] && source ~/.zshrc.local
